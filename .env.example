# Portal database (SQLAlchemy → PostgreSQL)
DATABASE_URL=postgresql://browseshield:change-me@db:5432/browseshield

# JWT Auth
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800
